  {
    "id": "evening",
    "kind": "practice",
    "title": "Evening journal",
    "emoji": "",
    "source": "builtin",
    "enabled": true,
    "schedule": [
      {
        "time": "23:00",
        "weekday": null
      }
    ],
    "closes": "day",
    "annotate": true,
    "collapse_hours": 6.0,
    "opener": {
      "mode": "companion",
      "shape": "a short opener (max ~1200 characters)",
      "limit": 1400,
      "plain": "{greet:Evening} Let the day land. Answer whatever pulls at you; you don't need to do them all."
    },
    "companion": "closure — process the day, release, carry forward one thread",
    "group": "",
    "path": "/package/library/practices/evening.md",
    "sections": [
      {
        "title": "Arriving",
        "questions": [
          {
            "id": "1.1",
            "text": "What are you feeling right now? Find a word for it, or a few. What might be behind it?",
            "pinned": false
          },
          {
            "id": "1.2",
            "text": "What's spinning in your mind? What do you need to put down before sleep?",
            "pinned": false
          }
        ]
      },
      {
        "title": "The Day",
        "questions": [
          {
            "id": "2.1",
            "text": "What went well today? Where were you present, patient or kind? Let yourself be glad of it.",
            "pinned": false
          },
          {
            "id": "2.2",
            "text": "What's the moment from today you'd tell as a story, even a small one?",
            "pinned": false
          },
          {
            "id": "2.3",
            "text": "What gave you energy, and what drained it?",
            "pinned": false
          },
          {
            "id": "2.4",
            "text": "Who showed up for you, and who did you show up for?",
            "pinned": false
          }
        ]
      },
      {
        "title": "One Moment, Looked at Again",
        "questions": [
          {
            "id": "3.1",
            "text": "Pick one moment that caused more harm than it needed to. How present were you in it? What came of it, for you and for anyone else?",
            "pinned": false
          },
          {
            "id": "3.2",
            "text": "Regret what deserves it, and leave out the guilt and the self-blame. What would you do differently, and is there anything to mend tomorrow?",
            "pinned": false
          }
        ]
      },
      {
        "title": "The Best Part of You",
        "questions": [
          {
            "id": "4.1",
            "text": "What would the best part of yourself say about how you did today?",
            "pinned": false
          }
        ]
      },
      {
        "title": "Closing",
        "questions": [
          {
            "id": "5.1",
            "text": "What are you grateful for from today?",
            "pinned": false
          },
          {
            "id": "5.2",
            "text": "You have lived this day. What do you want to carry into sleep?",
            "pinned": false
          }
        ]
      }
    ],
    "mtime": 1760000000.0,
    "default_changed": null
