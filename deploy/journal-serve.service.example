[Unit]
Description=journal serve (private web app and API)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv

[Service]
Type=simple
ExecStartPre=/usr/bin/mountpoint -q /srv
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
ExecStart=/home/you/.local/bin/journal --config /home/you/.config/journal/companion.json --hermes-home /home/you/.hermes/profiles/companion serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=process
UMask=0077
NoNewPrivileges=yes
MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=0
TasksMax=64
CPUWeight=50

[Install]
WantedBy=default.target
