{
  "name": "journal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The journal PWA: a responsive Preact app served by `journal serve`, installable, with offline reads.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.26.0",
    "preact-iso": "^2.9.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@preact/preset-vite": "^2.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "workbox-cacheable-response": "7.4.0",
    "workbox-core": "7.4.1"
  }
}
